/*
 * =============================================================================
 * pureTarget/conf/pureTarget.config — pipeline config (between lrsShared.config and finalize.config)
 * PureTarget repeat-expansion pipeline: params, run-aggregated output layout.
 * Shared values come from lrsShared.config.
 * =============================================================================
 * Replaces /data/configs/nextflowPureTarget.config. Renamed keys (snake_case ->
 * canonical) are in tools/params_rename.tsv. Removed: the env {} scope
 * (s_bind, simgpath, tmpDIR, assembly were read only by the uncalled vntyper2
 * process), methylationBackground(Local) and genome_fasta_dict (never read; the
 * dict pointed at ucsc.hg38.NGS.analysisSet.dict, which does not match the fasta).
 * =============================================================================
 */

params {
    single          = null          // --single: one folder per sample instead of per run
    layoutMode      = null          // default | perSample

    dataArchive     = params.dataArchivePureTarget       // shared with PTCP

    // CHANGED: was errorStrategy 'ignore' (veryHigh: 'terminate'). 'cohort'
    // retries transient failures twice, then ignores; needs the FAILED_TASKS
    // manifest in main.nf workflow.onComplete.
    errorMode       = 'cohort'

    // Kept as before; the shared default would be
    // /nfs_fast_b/data/nextflowSlurmWork/<user>/<yyMMdd>_<sheet>
    slurmWorkDir    = "/lnx01_data2/slurmWork/${params.runUser}/${params.traceStamp}_${launchDir.baseName}"
}

// Kept as before: pureTarget plots every disease locus except DRPLA_ATN1.
// Decide whether to converge with germline (which plots DRPLA_ATN1 too).
params.puretargetPlotGenes = params.puretargetPlotGenes - ['DRPLA_ATN1']

params.readSet       = params.hifiReads ? 'HiFiReads' : 'AllReads'

// was outputDirTMP. Output root (decided 23 Oct), next to PTCP:
//   /lnx01_data2/shared/patients/pacbioLRS/<genome>/<year>/pureTarget/<runKey>_<readSet>/
// (was /lnx01_data2/shared/patients/pureTarget/<genome>/<year>/). --outdir <x>
// replaces it with <x>_<readSet>, as before.
params.outputDirBase = params.outdir
    ? "${params.outdir}_${params.readSet}"
    : "${params.patientsLrsRoot}/${params.genome}/${params.yearStamp}/pureTarget"

if (!params.layoutMode) {
    params.layoutMode = params.single ? 'perSample' : 'default'
}

// Run-aggregated layout (unchanged): one folder per run, one subfolder per
// output type holding every sample. Sample identity is in the file names.
params.outBase = { meta ->
    switch (params.layoutMode) {
        case 'default':
            return "${params.outputDirBase}/${meta.outKey}_${params.readSet}"
        case 'perSample':
            return "${params.outputDirBase}/${meta.outKey}/${meta.npn}"
        default:
            throw new IllegalArgumentException("Unknown layoutMode='${params.layoutMode}' (expected: default|perSample)")
    }
}
